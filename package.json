{
  "name": "gupsik-jjokji",
  "productName": "급식쪽지",
  "version": "1.0.0",
  "description": "오늘 급식과 학사일정을 바탕화면 포스트잇으로 보여주는 프로그램 (made by junjunT)",
  "author": "junjunT",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "kr.junjunt.gupsikjjokji",
    "productName": "급식쪽지",
    "artifactName": "급식쪽지-${version}-${os}.${ext}",
    "files": ["main.js", "preload.js", "neis.js", "renderer/**", "build/icon.png"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "급식쪽지" },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.utilities" },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Utility" }
  }
}
